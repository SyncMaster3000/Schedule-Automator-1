{
  "name": "schedule-constructor-desktop",
  "version": "1.0.0",
  "description": "Десктопное приложение для составления расписаний учебных занятий (полностью офлайн)",
  "author": "Schedule Constructor",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "vite build",
    "start": "electron .",
    "preview": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "mammoth": "^1.9.0",
    "node-html-parser": "^7.0.1",
    "pizzip": "^3.1.7",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "sortablejs": "^1.15.6",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-draggable-next": "^2.2.1",
    "vue-router": "^4.5.0",
    "wait-on": "^8.0.2"
  }
}
